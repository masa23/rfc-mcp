[Unit]
Description=RFC MCP Server
After=network.target

[Service]
Type=simple

# Run as an unprivileged user. This service does not need root.
DynamicUser=yes

# Create /var/cache/rfc-mcp (and set permissions) automatically.
CacheDirectory=rfc-mcp

ExecStart=/usr/bin/rfc-mcp -config=/etc/rfc-mcp.yaml
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
